{
  "name": "customer-accounting",
  "version": "1.4.1",
  "description": "FMT — offline desktop customer accounting application",
  "main": "./out/main/index.js",
  "author": "FMT",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HashmatKhanSediqi/sameer-desktop-app.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "node scripts/ensure-win-build.mjs && npm run build && electron-builder --win --publish never && node scripts/verify-win-native-modules.mjs && node scripts/verify-win-installer.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "rebuild:node": "node scripts/rebuild-node.mjs",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "ensure:electron": "node node_modules/electron/install.js",
    "pretest": "npm run rebuild:node",
    "predev": "npm run rebuild:electron",
    "prebuild": "npm run rebuild:electron",
    "test": "vitest run",
    "test:extreme": "npm run rebuild:node && node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run tests/integration/extremeScale.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "icons:build": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "arabic-persian-reshaper": "^1.0.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.8.1",
    "bidi-js": "^1.0.3",
    "decimal.js": "^10.4.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "i18next": "^24.2.2",
    "pdfkit": "^0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.customeraccounting.app",
    "productName": "FMT",
    "icon": "assets/icons/icon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "assets/installer"
    },
    "afterPack": "scripts/after-pack-icon.cjs",
    "files": [
      "out/**/*",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      },
      {
        "from": "assets/fonts",
        "to": "fonts"
      },
      {
        "from": "assets/icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "differentialPackage": false,
      "artifactName": "FMT-Setup.${ext}",
      "shortcutName": "FMT",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "assets/installer/installer.nsh",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HashmatKhanSediqi",
        "repo": "sameer-desktop-app",
        "private": false,
        "releaseType": "release"
      }
    ]
  }
}
